{
  "name": "PopItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the Funko Pop figure"
    },
    "series": {
      "type": "string",
      "description": "Series/franchise (e.g., Marvel, Disney, Star Wars)"
    },
    "number": {
      "type": "number",
      "description": "Funko Pop number identifier"
    },
    "purchasePrice": {
      "type": "number",
      "description": "Price paid when purchased"
    },
    "marketValue": {
      "type": "number",
      "description": "Current estimated market value"
    },
    "image": {
      "type": "string",
      "description": "URL to the Funko Pop image"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Grail"
      ],
      "description": "Rarity tier of the item"
    },
    "purchaseDate": {
      "type": "string",
      "format": "date",
      "description": "Date the item was purchased"
    },
    "condition": {
      "type": "string",
      "enum": [
        "Mint",
        "Near Mint",
        "Good",
        "Fair"
      ],
      "default": "Mint",
      "description": "Condition of the item"
    },
    "isExclusive": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an exclusive release"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the item"
    }
  },
  "required": [
    "name",
    "series",
    "number",
    "purchasePrice"
  ]
}