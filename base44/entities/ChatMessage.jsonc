{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The message text"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "author_initials": {
      "type": "string",
      "description": "Initials for avatar fallback"
    }
  },
  "required": [
    "text",
    "author_name",
    "author_email"
  ]
}